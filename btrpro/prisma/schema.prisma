// BTRpro data model. SQLite for local dev; switch provider to
// "postgresql" for production (see README). Enums and Json need Prisma >= 6.2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

enum Role {
  ADMIN
  ESTIMATOR
  // office staff: billing, payments, supplier bills, crew pay, customers
  OFFICE
  // purchasing: orders, deliveries, supplier bills, price sheets
  PURCHASING
  VIEWER
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(ESTIMATOR)
  // owners get the Audit tools and owner approvals
  isOwner             Boolean   @default(false)
  // phone shown on proposals as the company representative's number (crewTexts is unused — no texts)
  phone               String?
  crewTexts           Boolean   @default(false)
  // project managers: their name as written in the schedule's Super column, and the builders and crews they run
  // (set by the office on Schedule → Who does what). PMs see these first on the dashboard and schedule.
  scheduleName        String?
  pmBuilders          Json?
  pmCrews             Json?
  createdAt           DateTime  @default(now())
  // when the user last opened the notifications panel (bell count = newer than this)
  notificationsSeenAt DateTime?

  messages           JobMessage[]
  summaries          JobSummary[]
  auditLogs          AuditLog[]
  estimates          Estimate[]
  emailsAdded        JobEmail[]
  sheetImports       SheetImport[]
  activity           ProjectActivity[]
  salesProjects      Project[]           @relation("ProjectSalesperson")
  estimatorProjects  Project[]           @relation("ProjectEstimator")
  projectViews       ProjectView[]
  mailboxConnections MailboxConnection[]
  costsEntered       JobCost[]
  commissionPlan     CommissionPlan?
  tasks              Task[]              @relation("TaskAssignee")
  companyUpdates     CompanyUpdate[]
  watching           JobWatch[]
}

// ---------- Price library ----------

enum PriceStatus {
  LISTED
  CALL
}

enum CoverageSource {
  PARSED_FROM_DESCRIPTION
  USER_ENTERED
  MANUFACTURER_DOC
}

model PriceSheet {
  id             String       @id @default(cuid())
  code           String // MH/EL/SS/HP/HS/NX/LP… — one active version per code
  name           String
  sourceFile     String?
  account        String?
  salesRep       String?
  effectiveDate  DateTime?
  expirationDate DateTime?
  scope          String?
  warning        String?
  // false = placeholder record with no items (e.g. LP SmartSide until uploaded)
  isLoaded       Boolean      @default(true)
  isActive       Boolean      @default(true)
  uploadedAt     DateTime     @default(now())
  // set when this version came from an upload (null = seeded from /data)
  importId       String?      @unique
  import         SheetImport? @relation(fields: [importId], references: [id])
  replacedAt     DateTime?
  // null = BTR standard pricing; set = a builder's own pricing, used only on that builder's jobs
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id])

  items PriceItem[]

  @@index([code, isActive])
}

model PriceItem {
  id             String          @id @default(cuid())
  sheetId        String
  sheet          PriceSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  section        String
  itemNumber     String
  description    String
  unitPrice      Float? // null when priceStatus = CALL
  uom            String // exactly as listed on the sheet; never converted
  priceStatus    PriceStatus     @default(LISTED)
  coverageQty    Float?
  coverageUnit   String?
  coverageSource CoverageSource?
  tags           Json?

  estimateLines EstimateLine[]

  @@unique([sheetId, itemNumber])
  @@index([itemNumber])
}

enum ImportStatus {
  DRAFT
  APPLIED
  DISCARDED
}

// An uploaded price sheet, parsed and waiting for Admin review. Nothing goes live until applied.
model SheetImport {
  id            String       @id @default(cuid())
  code          String
  name          String
  scope         String?
  fileName      String
  fileUrl       String
  format        String // ZIP_TXT | PDF | CSV | TEXT
  extractedText String
  header        Json // { effective, expiration, account, salesRep }
  rows          Json // ParsedRow[]
  unparsed      Json // { line, text }[]
  status        ImportStatus @default(DRAFT)
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  appliedAt     DateTime?
  companyId     String?

  sheet PriceSheet?
}

// ---------- Projects & intake ----------

enum ConstructionType {
  NEW
  REROOF
}

enum Form17Status {
  NOT_REQUIRED
  PENDING
  EXECUTED
}

// Job workflow (BUILD_PROMPT §13). LOST can be reached from any stage before SOLD.
enum ProjectStatus {
  LEAD
  ESTIMATING
  SUBMITTED
  SOLD
  SCHEDULED
  IN_PRODUCTION
  COMPLETE
  INVOICED
  PAID
  CLOSED
  LOST
}

// Two sides of the business. Residential: homeowners, insurance claims, deposits.
// Commercial: GCs/owners, bid dates, public bids, bonds, retainage, pay apps.
enum Market {
  RESIDENTIAL
  COMMERCIAL
}

enum Readiness {
  NOT_READY
  BUDGET
  BID_READY
}

model Project {
  id                 String            @id @default(cuid())
  name               String
  market             Market            @default(COMMERCIAL)
  address            String?
  buildingUse        String?
  constructionType   ConstructionType?
  // STEEP | LOW_SLOPE | DECK | SIDING | PANELS — drives which intake fields apply
  scopes             Json?
  // what kind of job: REROOF | NEW_ROOF | SIDING | GUTTERS | INSULATION | WINDOWS | REPAIR | WARRANTY
  workTypes          Json?
  isPublic           Boolean           @default(false)
  isTaxExempt        Boolean           @default(false)
  form17Status       Form17Status      @default(NOT_REQUIRED)
  form17ExecutedAt   DateTime?
  form17ExecutedBy   String?
  form17Note         String?
  bidDueDate         DateTime?
  acculynxJobNumber  String?
  // set by the job-schedule import; the same schedule row maps to the same job on every re-import
  importKey          String?
  // customer portal link (secret; null = not shared)
  portalToken        String?
  // CompanyCam project id, and the EagleView report on order
  companyCamId       String?
  // Drive folder CompanyCam syncs this job's photos into (BTR Contracting/CompanyCam/<project - address>)
  photoFolderId      String?
  // the job's folder in the company jobs Drive (set by the Drive job import; files copied, Drive untouched)
  driveFolderId      String?
  eagleViewReportId  String?
  eagleViewOrderedAt DateTime?
  leadSource         String?
  // NORMAL | HIGH (job header priority dropdown)
  priority           String            @default("NORMAL")
  punchItems         PunchItem[]
  fieldIssues        FieldIssue[]
  estimateLogs       EstimateLog[]
  prodLines          ProdLine[]
  payContracts       PayContract[]
  // ready-to-schedule items ticked by hand: { color, permit, dumpster, notified }
  readyChecks        Json?
  webLeads           WebLead[]
  billingSteps       BillingStep[]
  // the customer's property this job is at (multi-family / commercial portfolios)
  propertyId         String?
  property           Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status             ProjectStatus     @default(LEAD)
  statusChangedAt    DateTime          @default(now())
  lostReason         String?
  // standard lost reason (LOST_REASONS) for the win/loss report
  lostCategory       String?
  // when someone first reached a new lead (call, text, booked)
  firstContactAt     DateTime?
  readiness          Readiness         @default(NOT_READY)
  contractAmount     Float?
  contractSignedAt   DateTime?
  // Residential insurance restoration
  isInsuranceClaim   Boolean           @default(false)
  insuranceCarrier   String?
  claimNumber        String?
  dateOfLoss         DateTime?
  adjusterName       String?
  adjusterPhone      String?
  adjusterEmail      String?
  deductible         Float?
  // Commercial
  bidBondRequired    Boolean           @default(false)
  perfBondRequired   Boolean           @default(false)
  prevailingWage     Boolean           @default(false)
  retainagePct       Float?
  clientCompanyId    String?
  clientCompany      Company?          @relation(fields: [clientCompanyId], references: [id])
  salespersonId      String?
  salesperson        User?             @relation("ProjectSalesperson", fields: [salespersonId], references: [id])
  estimatorId        String?
  estimator          User?             @relation("ProjectEstimator", fields: [estimatorId], references: [id])
  // inbound address token for forwarding job emails (e.g. job-<token>@…)
  emailToken         String            @unique @default(cuid())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  intake       IntakeField[]
  documents    Document[]
  measurements Measurement[]
  estimates    Estimate[]
  openItems    OpenItem[]
  bidResults   BidResult[]
  messages     JobMessage[]
  emails       JobEmail[]
  summaries    JobSummary[]
  contacts     ProjectContact[]
  activity     ProjectActivity[]
  views        ProjectView[]
  // search words for pulling this job's email from a connected mailbox (defaults to name/claim #/address)
  mailQuery    String?

  // Job costing (§12). The baseline is frozen from one estimate revision when the job is sold.
  costBaseline     Json?
  costBaselineAt   DateTime?
  costs            JobCost[]
  commitments      CostCommitment[]
  changeOrders     ChangeOrder[]
  // categories an Admin/estimator marked "no bills expected" for close-out
  costNoneExpected Json?
  costClosedAt     DateTime?
  // WIP: the PM's estimate of cost still to come (blank = budget − cost to date), and when it was last updated
  wipEtc           Float?
  wipEtcAt         DateTime?
  wipEtcBy         String?
  costClosedBy     String?
  // the P&L as it stood when the job was closed; later edits are Admin-only and audit-logged
  finalPnl         Json?
  materialOrders   MaterialOrder[]
  scheduleEvents   ScheduleEvent[]
  workOrders       WorkOrder[]
  timeEntries      TimeEntry[]
  invoices         Invoice[]
  qboCustomerId    String?
  // QuickBooks estimate made when the job is opened; its number is the job number everyone uses ("est 6024")
  qboEstimateId    String?
  qboJobNo         String?
  tasks            Task[]
  watchers         JobWatch[]
  crewInvoices     CrewInvoice[]
  photos           JobPhoto[]
  receiptScans     ReceiptScan[]

  @@index([importKey])
  @@index([portalToken])
}

// Timeline of everything that happened on a job: stage changes, intake edits, Form 17, overrides.
model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  kind      String // created | stage | intake | form17 | details | contact | override
  text      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// ---------- Customers (CRM) ----------

enum CompanyType {
  BUILDER
  GC
  OWNER
  PROPERTY_MANAGER
  PUBLIC_AGENCY
  ARCHITECT
  SUBCONTRACTOR
  SUPPLIER
  OTHER
}

model Company {
  id              String      @id @default(cuid())
  name            String
  type            CompanyType @default(OTHER)
  phone           String?
  email           String?
  address         String?
  notes           String?
  // Home builders: their own negotiated ABC pricing (builder price sheets)
  // short code prefixed to their sheet codes, e.g. LEG → LEG-SS
  sheetPrefix     String?
  abcAccount      String?
  // items missing from the builder's sheets: STANDARD = BTR standard price, flagged · MISSING = leave MISSING
  pricingFallback String?
  poRequired      Boolean     @default(false)
  standardSpecs   String?
  billingTerms    String?
  website         String?
  createdAt       DateTime    @default(now())

  contacts    Contact[]
  projects    Project[]
  priceSheets PriceSheet[]
  properties  Property[]
  planBooks   BuilderPlanBook[]
  starts      BuilderStart[]
}

// A property a customer manages (e.g. one apartment community of a property-management company). Jobs happen at a
// property; its office and site staff are the job's contacts.
model Property {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  email     String?
  notes     String?
  // set when the property came from an imported directory, so a newer directory updates it instead of duplicating
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  projects  Project[]

  @@index([companyId])
}

model Contact {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  title      String?
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  email      String?
  phone      String?
  // digits only, for duplicate detection
  phoneKey   String?
  address    String?
  notes      String?
  // the property this person works at (site manager, maintenance…); null = the company's office
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // a second number (direct line / office) when a directory lists one
  phone2     String?
  createdAt  DateTime  @default(now())

  projects ProjectContact[]

  @@index([email])
  @@index([phoneKey])
}

enum ContactRole {
  HOMEOWNER
  OWNER_REP
  GC_PM
  SUPERINTENDENT
  PROPERTY_MANAGER
  ARCHITECT
  BILLING
  OTHER
}

model ProjectContact {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      ContactRole @default(OTHER)
  isPrimary Boolean     @default(false)

  @@unique([projectId, contactId])
}

enum FieldStatus {
  VERIFIED
  MISSING
  ASSUMED
  NOT_APPLICABLE
}

model IntakeField {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String // one of the 19 intake keys in CLAUDE.md §4
  value       String?
  unit        String?
  status      FieldStatus @default(MISSING)
  sourceDocId String?
  sourcePage  Int?
  approvedBy  String?
  note        String?
  // set when the field was marked N/A automatically because it's outside the job's scopes
  autoNa      Boolean     @default(false)
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, key])
}

enum DocumentType {
  EAGLEVIEW
  PLANS
  SPECS
  MFR_DATA
  SUB_PROPOSAL
  CHANGE_ORDER
  PHOTO
  OTHER
}

model Document {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          DocumentType @default(OTHER)
  fileName      String
  fileUrl       String
  pages         Int?
  extractedText String? // pages separated by \f (form feed)
  source        String       @default("UPLOAD") // UPLOAD | EMAIL | DRIVE | EAGLEVIEW
  externalId    String? // Drive file id, EagleView report id … for de-duplication
  contentType   String?
  sizeBytes     Int?
  uploadedById  String?
  uploadedAt    DateTime     @default(now())
  jobEmailId    String?
  jobEmail      JobEmail?    @relation(fields: [jobEmailId], references: [id], onDelete: SetNull)

  measurements Measurement[]
  facts        ExtractedFact[]
  runs         ExtractionRun[]
  costs        JobCost[]
  planReviews  PlanReview[]
  takeoffs     PlanTakeoff[]
}

enum MeasurementStatus {
  EXTRACTED_PENDING
  CONFIRMED
  REJECTED
  USER_ENTERED
}

model Measurement {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            String // roof_total_sf, siding_sf, … (see BUILD_PROMPT.md)
  value          Float?
  unit           String?
  facet          String?
  sourceDocId    String?
  sourceDoc      Document?         @relation(fields: [sourceDocId], references: [id], onDelete: SetNull)
  sourcePage     Int?
  status         MeasurementStatus @default(EXTRACTED_PENDING)
  confirmedBy    String?
  extractedValue Float? // what the AI read, kept when a person edits the value
  quote          String? // text on the page the value came from
  note           String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// ---------- Estimates ----------

enum ScopeType {
  STEEP
  LOW_SLOPE
  DECK
  SIDING
  PANELS
  MIXED
}

enum LineSection {
  MATERIAL_ROOFING
  MATERIAL_DECK
  MATERIAL_SIDING
  GENERAL_CONDITIONS
  LABOR
}

enum SourceStatus {
  VERIFIED
  SHEET_STALE
  SHEET_EXPIRED
  CALL_FOR_PRICE
  MISSING_ITEM
  MISSING_PRICE
  PLACEHOLDER
  ASSUMPTION_APPROVED
  PENDING_AI
  MISSING
}

model Estimate {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String // Rev 1, Rev 2…
  scopeType         ScopeType
  wastePctBySection Json?
  wasteApproved     Boolean   @default(false)
  contingencyPct    Float?
  notes             String?
  createdById       String?
  createdBy         User?     @relation(fields: [createdById], references: [id])
  locked            Boolean   @default(false)
  revision          Int       @default(1)
  takeoff           Json?
  createdAt         DateTime  @default(now())

  lines      EstimateLine[]
  laborLines LaborLine[]
  openItems  OpenItem[]
  scopeItems ScopeItem[]
}

model EstimateLine {
  id                 String       @id @default(cuid())
  estimateId         String
  estimate           Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section            LineSection
  itemName           String
  priceItemId        String?
  priceItem          PriceItem?   @relation(fields: [priceItemId], references: [id])
  supplierItemNumber String?
  quantity           Float?
  unit               String?
  unitCost           Float?
  total              Float?
  formula            String?
  formulaInputs      Json?
  sourceStatus       SourceStatus @default(MISSING)
  ruleId             String?
  substitution       Boolean      @default(false)
  sortOrder          Int          @default(0)
  // "steep:shingles" etc. for takeoff-generated lines; null for lines added by hand
  calcKey            String?
  note               String?
  substitutionNote   String?
  createdAt          DateTime     @default(now())
}

model LaborLine {
  id             String       @id @default(cuid())
  estimateId     String
  estimate       Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  task           String
  crewSize       Int?
  productionRate Float?
  productionUnit String?
  laborHours     Float?
  hourlyRate     Float?
  // piece rate ($ per quantity unit) instead of hours × $/hr
  unitRate       Float?
  burdenPct      Float?
  total          Float?
  sourceStatus   SourceStatus @default(MISSING)
  quantity       Float?
  quantityUnit   String?
  quantitySource String?
  standardId     String?
  note           String?
  sortOrder      Int          @default(0)
}

// Company library — starts EMPTY. Never seeded with invented rates.
model LaborStandard {
  id             String   @id @default(cuid())
  task           String
  // HOURLY: units per labor-hour × $/hr × burden · UNIT: a piece rate paid per unit ($/SQ, $/LF, $/EA)
  rateType       String   @default("HOURLY")
  unitRate       Float?
  category       String?
  // set on standards loaded from a company file, so reloading doesn't duplicate them
  seedKey        String?
  productionRate Float?
  unit           String
  crewSize       Int?
  hourlyRate     Float?
  burdenPct      Float?
  source         String
  enteredBy      String
  createdAt      DateTime @default(now())
}

model Rule {
  id         String  @id // e.g. ROOF-03
  scope      String
  text       String
  formula    String?
  itemNumber String?
  extra      Json? // default_items, check, logic from company_rules.json
  locked     Boolean @default(false)
  active     Boolean @default(true)
}

model OpenItem {
  id         String    @id @default(cuid())
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  estimateId String?
  estimate   Estimate? @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  text       String
  owner      String?
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

enum ScopeItemType {
  WE_WILL
  WE_WILL_NOT
}

model ScopeItem {
  id         String        @id @default(cuid())
  estimateId String
  estimate   Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type       ScopeItemType
  text       String
  sortOrder  Int           @default(0)
}

model BidResult {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ourBid    Float?
  won       Boolean?
  bidTabs   Json? // [{ bidder, amount }]
  notes     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String // PriceItem, Rule, Estimate…
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

// ---------- Job communication (per-project chat + email) ----------

// Internal team chat, one thread per job, replacing internal email chains.
model JobMessage {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  body      String
  mentions  Json? // user ids @mentioned
  parentId  String? // reply-to
  parent    JobMessage?  @relation("Replies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   JobMessage[] @relation("Replies")
  createdAt DateTime     @default(now())
  editedAt  DateTime?

  @@index([projectId, createdAt])
}

enum EmailSource {
  FORWARDED // sent to the job's inbound address
  GMAIL // pulled from a connected mailbox
  MANUAL // pasted in
}

// External email attached to a job (GC, owner, supplier, subs).
model JobEmail {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source      EmailSource
  externalId  String? // Message-ID / provider id, for de-duplication
  threadId    String?
  fromAddr    String
  toAddrs     String?
  subject     String
  sentAt      DateTime
  bodyText    String
  summary     String? // AI one-paragraph summary of this email
  addedById   String?
  addedBy     User?       @relation(fields: [addedById], references: [id])
  createdAt   DateTime    @default(now())
  attachments Document[]

  @@unique([projectId, externalId])
  @@index([projectId, sentAt])
}

enum SummaryKind {
  CATCH_UP // whole job: chat + emails + estimate status + open items
  EMAIL_THREAD
}

// Stored AI summaries so anyone can get caught up on a job.
model JobSummary {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        SummaryKind
  threadId    String?
  content     String
  coversFrom  DateTime?
  coversTo    DateTime
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
}

// When each user last looked at a job's chat and its catch-up, for unread counts and "since you last looked".
model ProjectView {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatReadAt   DateTime  @default(now())
  caughtUpAt   DateTime?
  // last time the user opened the job at all (the Recent menu)
  lastViewedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId, lastViewedAt])
}

enum MailProvider {
  GOOGLE
  MICROSOFT
}

// A user's connected mailbox for pulling job emails. Tokens are encrypted at rest.
model MailboxConnection {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     MailProvider
  email        String
  accessToken  String // encrypted
  refreshToken String? // encrypted
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  @@unique([userId, provider])
}

enum FactStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Non-numeric facts read from plans/specs (roof system, warranty, deck type, spec sections…).
// Confirming one fills the matching intake field as VERIFIED with its source page.
model ExtractedFact {
  id         String     @id @default(cuid())
  projectId  String
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  key        String // intake key, or "spec_section"
  value      String
  page       Int?
  quote      String?
  status     FactStatus @default(PENDING)
  decidedBy  String?
  createdAt  DateTime   @default(now())
}

model ExtractionRun {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind       String // EAGLEVIEW | PLANS_SPECS
  status     String // OK | FAILED
  message    String?
  model      String?
  createdAt  DateTime @default(now())
}

// New-construction plan & spec review: an estimator brief read from a plan set or project manual.
// Every item carries the original PDF page and quote. Facts, pitches, roof area and RFIs also go to the
// confirmation queue / open items; nothing here is used in math until a person confirms it.
model PlanReview {
  id          String   @id @default(cuid())
  projectId   String
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status      String // OK | FAILED
  pagesSent   Json? // original page numbers sent, null = whole document
  brief       Json?
  message     String?
  model       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([documentId])
}

// OAuth/API connections for integrations (Drive, QuickBooks, Procore, Buildertrend, CompanyCam, EagleView, ABC).
// userId null = company-wide connection. Secrets encrypted at rest.
model IntegrationConnection {
  id           String    @id @default(cuid())
  provider     String
  userId       String?
  accountLabel String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  extra        Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([provider, userId])
}

// Per-job AI estimator assistant conversation (shared by the team on that job).
model AssistantMessage {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  role      String // user | assistant
  content   String
  toolTrace Json? // tools called during this turn: [{ name, input, ok }]
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// Company-wide settings entered by an Admin (markup, tax, deposit, proposal terms). Start empty.
model CompanySetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Customer proposal made from an estimate revision, signed electronically through a private link.
model Proposal {
  id                 String    @id @default(cuid())
  projectId          String
  estimateId         String
  number             String    @unique
  title              String
  status             String    @default("DRAFT") // DRAFT | SENT | VIEWED | SIGNED | DECLINED | VOID
  token              String    @unique
  costTotal          Float
  taxPct             Float?
  taxAmount          Float     @default(0)
  markupPct          Float
  basePrice          Float
  priceNote          String?
  alternates         Json? // [{ name, description, price }]
  selectedAlternates Json? // names picked by the customer
  acceptedTotal      Float?
  depositPct         Float?
  terms              String
  scope              Json // { weWill: string[], weWillNot: string[] }
  validUntil         DateTime?
  recipientName      String?
  recipientEmail     String?
  sentAt             DateTime?
  viewedAt           DateTime?
  viewCount          Int       @default(0)
  lastViewedAt       DateTime?
  signedAt           DateTime?
  declinedAt         DateTime?
  declineReason      String?
  signerName         String?
  signerEmail        String?
  signerIp           String?
  signerAgent        String?
  signatureImage     String? // PNG data URL when drawn
  signedDocumentId   String?
  createdById        String?
  createdAt          DateTime  @default(now())

  @@index([projectId])
}

// ---------- Job costing (§12) ----------

enum CostCategory {
  MATERIALS
  LABOR
  SUBCONTRACTOR
  EQUIPMENT
  DISPOSAL
  PERMITS
  OTHER
}

model JobCost {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category     CostCategory
  date         DateTime
  vendor       String
  reference    String? // invoice #, ticket #, check #
  description  String
  // negative for returns and credits
  amount       Float
  // how the amount was reached, when the app did the arithmetic (hours × rate × burden, qty × price)
  formula      String?
  // INVOICE | RECEIPT | CREDIT | CREW_HOURS | SUB_BILL | PAY | IMPORT
  kind         String          @default("INVOICE")
  hours        Float?
  rate         Float?
  burdenPct    Float?
  quantity     Float?
  unit         String?
  unitPrice    Float?
  itemNumber   String?
  // unit price on the current price sheet when the invoice line was imported (for price checks)
  sheetPrice   Float?
  importBatch  String?
  commitmentId String?
  commitment   CostCommitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  documentId   String?
  document     Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  enteredById  String?
  enteredBy    User?           @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([projectId])
}

// Money the job has committed to but hasn't been billed for yet: open material orders, accepted sub proposals.
model CostCommitment {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    CostCategory
  vendor      String
  description String
  amount      Float
  reference   String?
  // OPEN | BILLED | CANCELLED
  status      String         @default("OPEN")
  documentId  String?
  enteredBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  bills       JobCost[]
  // set when the commitment was created by sending a material order
  orderId     String?        @unique
  order       MaterialOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

enum ChangeOrderKind {
  CHANGE_ORDER
  SUPPLEMENT
  CREDIT
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  REJECTED
}

// Revenue changes after the contract. Only APPROVED ones count toward revenue.
model ChangeOrder {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number           String
  kind             ChangeOrderKind   @default(CHANGE_ORDER)
  description      String
  // always entered positive; CREDIT subtracts
  amount           Float
  // added cost the change brings, if known (feeds the estimated-cost baseline)
  costImpact       Float?
  status           ChangeOrderStatus @default(PENDING)
  source           String? // "Signed CO", "Adjuster supplement email 9/12", …
  documentId       String?
  decidedAt        DateTime?
  decidedBy        String?
  createdBy        String?
  externalRef      String? // Buildertrend / Procore CO id once synced
  // estimate revision the CO was priced from (same rules as estimates)
  estimateId       String?
  priceFormula     String?
  // customer e-signature
  token            String?
  sentAt           DateTime?
  sentTo           String?
  signerName       String?
  signerEmail      String?
  signedAt         DateTime?
  signerIp         String?
  signatureImage   String?
  signedDocumentId String?
  // materials billed on the change order (from a receipt): [{ vendor, item, qty, amount }]
  lines            Json?
  declineReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([token])
}

enum CommissionBasis {
  REVENUE
  GROSS_PROFIT
}

model CommissionPlan {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  basis     CommissionBasis
  pct       Float
  note      String?
  updatedBy String?
  updatedAt DateTime        @updatedAt
}

// ---------- Material orders and deliveries (§13) ----------

enum MaterialOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIAL
  DELIVERED
  CANCELLED
}

model MaterialOrder {
  id                  String              @id @default(cuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // our PO number; put it on the supplier order so invoices can be matched back to the job
  number              String              @unique
  estimateId          String?
  supplier            String
  status              MaterialOrderStatus @default(DRAFT)
  requestedDate       DateTime?
  deliveryWindow      String? // AM | PM | ANYTIME | WILL_CALL
  dropLocation        String? // driveway, roof load, street, …
  siteContact         String?
  notes               String?
  supplierOrderNumber String?
  confirmedDate       DateTime?
  sentAt              DateTime?
  sentTo              String?
  sentBy              String?
  sentMethod          String? // EMAIL | MANUAL
  cancelReason        String?
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lines               MaterialOrderLine[]
  tickets             DeliveryTicket[]
  commitment          CostCommitment?
}

model MaterialOrderLine {
  id             String        @id @default(cuid())
  orderId        String
  order          MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemNumber     String?
  description    String
  quantity       Float?
  unit           String?
  priceItemId    String?
  // expected cost from the price sheet; null when the item is CALL or the unit doesn't match the sheet
  extended       Float?
  priceFormula   String?
  received       Float         @default(0)
  backordered    Float         @default(0)
  backorderDate  DateTime?
  returned       Float         @default(0)
  estimateLineId String?
  note           String?
  sortOrder      Int           @default(0)
}

model DeliveryTicket {
  id           String        @id @default(cuid())
  orderId      String
  order        MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date         DateTime
  ticketNumber String?
  documentId   String?
  note         String?
  receivedBy   String
  createdAt    DateTime      @default(now())
}

// ---------- Production: crews, subs, schedule, work orders, timesheets (§13) ----------

enum CrewKind {
  CREW
  SUB
}

model Crew {
  id                 String          @id @default(cuid())
  name               String
  kind               CrewKind        @default(CREW)
  trade              String? // roofing, siding, gutters, metal…
  // work the crew does, picked from CREW_SCOPES on Schedule → Who does what
  scopes             Json?
  leadName           String?
  phone              String?
  email              String?
  // default pay: HOURLY (rate/h + burden) or PIECE (rate per unit, e.g. $/SQ)
  payType            String?
  defaultRate        Float?
  rateUnit           String? // SQ, SF, LF, H
  burdenPct          Float?
  coiExpires         DateTime?
  workersCompExpires DateTime?
  licenseNumber      String?
  licenseExpires     DateTime?
  complianceFileUrl  String?
  notes              String?
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  events             ScheduleEvent[]
  workOrders         WorkOrder[]
  timeEntries        TimeEntry[]
  // crew's phone link: their schedule, work orders, hours, delivery tickets
  portalToken        String?
  // crew portal login (invoices + job photos only); separate from staff accounts
  loginEmail         String?
  passwordHash       String?
  lastLoginAt        DateTime?
  // set when the office sets/resets the password or turns the login off; older crew sessions stop working
  loginChangedAt     DateTime?
  invoices           CrewInvoice[]
  photos             JobPhoto[]

  @@index([portalToken])
  @@index([loginEmail])
}

enum EventKind {
  APPOINTMENT
  INSTALL
  TEAR_OFF
  INSPECTION
  DUMPSTER
  REPAIR
  OTHER
}

model ScheduleEvent {
  id          String    @id @default(cuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        EventKind @default(INSTALL)
  title       String
  // all-day, inclusive date range (stored at noon UTC)
  startDate   DateTime
  endDate     DateTime
  crewId      String?
  crew        Crew?     @relation(fields: [crewId], references: [id], onDelete: SetNull)
  // TENTATIVE | CONFIRMED | DONE | CANCELLED
  status      String    @default("TENTATIVE")
  weatherNote String?
  notes       String?
  // why it was scheduled despite a conflict or expired insurance
  override    String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WorkOrder {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       String    @unique
  crewId       String
  crew         Crew      @relation(fields: [crewId], references: [id])
  // DRAFT | SENT | IN_PROGRESS | COMPLETE | CANCELLED
  status       String    @default("DRAFT")
  scope        Json? // string[] — "We will" lines
  exclusions   Json? // string[] — "We will not" lines
  instructions String?
  startDate    DateTime?
  // what we pay: PIECE (qty × rate) or LUMP (agreed amount); HOURLY crews log time instead
  payBasis     String? // PIECE | LUMP | HOURLY
  payQty       Float?
  payUnit      String?
  payRate      Float?
  amount       Float?
  payFormula   String?
  token        String    @unique
  sentAt       DateTime?
  viewedAt     DateTime?
  completedAt  DateTime?
  completedBy  String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  commitmentId String?
}

model TimeEntry {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crewId     String
  crew       Crew      @relation(fields: [crewId], references: [id])
  date       DateTime
  // HOURLY: hours (total crew-hours) × rate × burden; PIECE: qty × rate
  basis      String
  hours      Float?
  qty        Float?
  unit       String?
  rate       Float
  burdenPct  Float?
  amount     Float
  formula    String
  note       String?
  enteredBy  String
  // set when an Admin/estimator approves it; approval posts it to job costing
  approvedBy String?
  approvedAt DateTime?
  jobCostId  String?
  createdAt  DateTime  @default(now())
}

// ---------- Invoicing & payments (§13) ----------

enum InvoiceKind {
  DEPOSIT
  PROGRESS
  FINAL
  CHANGE_ORDER
  RETAINAGE_RELEASE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

model Invoice {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number       String           @unique
  kind         InvoiceKind
  status       InvoiceStatus    @default(DRAFT)
  // [{ description, amount }]
  lines        Json
  subtotal     Float
  retainagePct Float?
  retainage    Float            @default(0)
  // subtotal − retainage
  amountDue    Float
  issueDate    DateTime
  dueDate      DateTime
  notes        String?
  // why it bills past the contract, when it does
  override     String?
  token        String           @unique
  billTo       String?
  billToEmail  String?
  sentAt       DateTime?
  viewedAt     DateTime?
  voidReason   String?
  qboId        String?
  qboSyncedAt  DateTime?
  qboError     String?
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  payments     Payment[]
  calls        CollectionNote[]
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date       DateTime
  // applied to the invoice (surcharge not included)
  amount     Float
  // CHECK | ACH | CARD | CASH | INSURANCE_CHECK | OTHER
  method     String
  reference  String?
  // card surcharge collected on top, where permitted
  surcharge  Float    @default(0)
  // MANUAL | STRIPE
  source     String   @default("MANUAL")
  externalId String?  @unique
  recordedBy String
  qboId      String?
  qboError   String?
  createdAt  DateTime @default(now())
}

// ---------- Estimate templates (product systems) ----------

// A saved takeoff setup for one module: the products for every slot, e.g. "GAF Timberline HDZ" or
// "Mulehide EPDM .060 fully adhered". Applying one fills an estimate's takeoff; quantities still come
// from the job's confirmed measurements.
model EstimateTemplate {
  id           String   @id @default(cuid())
  // built-in templates are seeded by key; user templates get a generated key
  key          String   @unique
  name         String
  category     String // SHINGLE | FLAT | SIDING | DECK | OTHER
  group        String // "Class 4 / impact-resistant", "EPDM", "Vinyl", "Hardie (Primed)"…
  brand        String?
  impactClass  String? // CLASS_4 | CLASS_3 | null (not verified)
  impactSource String?
  scopeType    String // STEEP | LOW_SLOPE | SIDING | DECK
  module       String // steep | lowSlope | siding | deck
  config       Json
  notes        String?
  builtIn      Boolean  @default(false)
  active       Boolean  @default(true)
  // a builder's own template (their standard specs); null = everyone
  companyId    String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Price sheets from Google Drive ----------

// One row per Drive file version seen in the price-sheet folder, so each is processed once.
model DriveSheetFile {
  id           String   @id @default(cuid())
  driveFileId  String
  name         String
  modifiedTime String
  // APPLIED | DRAFT (held for review) | SKIPPED_OLDER | UNMATCHED | ERROR
  status       String
  code         String?
  importId     String?
  message      String?
  checkedAt    DateTime @default(now())

  @@index([driveFileId, modifiedTime])
}

// ---------- Tasks and reminders (§13) ----------

// A to-do on a job (or company-wide when projectId is null). Workflow stages create some automatically;
// `auto` is the rule key so a stage re-entered later doesn't create the same task twice.
model Task {
  id         String    @id @default(cuid())
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  notes      String?
  dueDate    DateTime?
  assigneeId String?
  assignee   User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  auto       String?
  createdBy  String?
  doneAt     DateTime?
  doneBy     String?
  createdAt  DateTime  @default(now())

  @@index([assigneeId, doneAt])
  @@index([projectId])
}

// Company-wide announcements shown on the dashboard and in everyone's notifications.
model CompanyUpdate {
  id        String   @id @default(cuid())
  title     String
  body      String
  pinned    Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A user's watch list: activity on watched jobs shows up in their notifications.
model JobWatch {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// A crew/sub's invoice sent from the crew portal. The office approves it into job costing.
model CrewInvoice {
  id            String    @id @default(cuid())
  crewId        String
  crew          Crew      @relation(fields: [crewId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String?
  invoiceDate   DateTime
  amount        Float
  description   String
  fileUrl       String?
  contentType   String?
  // SUBMITTED | APPROVED | REJECTED | PAID
  status        String    @default("SUBMITTED")
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  paidAt        DateTime?
  jobCostId     String?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@index([projectId])
}

// Job photos taken by crews (and staff): before, progress, finished work, and site cleanup.
// Finished + cleanup are required before a crew can invoice the job; the office reviews quality and cleanliness.
model JobPhoto {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crewId      String?
  crew        Crew?     @relation(fields: [crewId], references: [id], onDelete: SetNull)
  uploadedBy  String
  // BEFORE | PROGRESS | FINISHED | CLEANUP
  stage       String
  note        String?
  fileUrl     String
  contentType String
  // PENDING | OK | ISSUE
  review      String    @default("PENDING")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  takenAt     DateTime  @default(now())

  @@index([projectId, stage])
  @@index([crewId])
}

// A photographed supplier receipt/invoice: what was read off it, the job it matched, and whether it was filed to costs.
model ReceiptScan {
  id            String        @id @default(cuid())
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // uploaded photos/PDF pages, in order: [{ url, type }]
  files         Json
  // READING | READ | FAILED | FILED
  status        String        @default("READ")
  // UPLOAD | EMAIL
  source        String        @default("UPLOAD")
  // who sent it: a staff user, or the email sender's name
  employeeId    String?
  employee      String?
  subject       String?
  message       String?
  emailId       String?
  // markup for billing the customer: receipt-wide %, plus per-line overrides { "<line index>": pct }
  markupPct     Float?
  lineMarkup    Json?
  // unit prices typed in by the office for lines with no printed price and none on our sheets: { "<line index>": price }
  linePrice     Json?
  // RECEIPT | INVOICE | DELIVERY_TICKET | OTHER (as read)
  docType       String?
  // COST_ONLY | CHANGE_ORDER | INVOICE
  outcome       String?
  changeOrderId String?
  invoiceId     String?
  qboStatus     String?
  error         String?
  // what the AI transcribed (header + lines), never edited by code
  extracted     Json?
  matchedBy     String?
  invoiceNo     String?
  vendor        String?
  costBatch     String?
  createdById   String
  createdAt     DateTime      @default(now())
  filedAt       DateTime?
  bill          SupplierBill?

  @@index([createdAt])
  @@index([emailId])
}

// A staff directory a customer sent (PDF/Word/photo): what was read, waiting for someone to preview and import it.
model DirectoryImport {
  id          String    @id @default(cuid())
  companyId   String?
  fileName    String
  fileUrl     String
  // READING | READ | FAILED | IMPORTED
  status      String    @default("READING")
  error       String?
  extracted   Json?
  result      Json?
  createdById String
  createdAt   DateTime  @default(now())
  importedAt  DateTime?
}

// One sheet's traced takeoff: scale, view, pitch and the drawn lines/areas/counts (points in sheet units).
model PlanTakeoff {
  id         String    @id @default(cuid())
  projectId  String
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int       @default(1)
  // ROOF_PLAN | ELEVATION | OTHER
  view       String    @default("ROOF_PLAN")
  pitch      Float?
  scale      Json?
  items      Json
  // { list: WallReturn[], checked: boolean } — returns at decks/entries (depth from the floor plan)
  returns    Json?
  // sheet size in its own units, so totals can be re-computed without opening the file
  width      Float?
  height     Float?
  savedToJob DateTime?
  updatedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([documentId, page])
  @@index([projectId])
}

// Final walkthrough punch list: open items block crew pay approval and completion.
model PunchItem {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  photoUrl  String?
  crewId    String?
  createdBy String
  createdAt DateTime  @default(now())
  doneAt    DateTime?
  doneBy    String?

  @@index([projectId])
}

// An on-account supplier invoice (accounts payable), read by the receipt reader and checked against our PO,
// delivery tickets and price sheets before the office approves it into job costs and a QuickBooks bill.
model SupplierBill {
  id              String      @id @default(cuid())
  scanId          String      @unique
  scan            ReceiptScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  vendor          String
  invoiceNumber   String?
  invoiceDate     DateTime?
  dueDate         DateTime?
  terms           String?
  total           Float?
  projectId       String?
  orderId         String?
  // NEEDS_LOOK | READY | APPROVED | PAID | DISPUTED | VOID
  status          String      @default("NEEDS_LOOK")
  // the three-way match result shown to the office
  match           Json?
  // set when an owner must approve (over the limit, or approved despite flags)
  needsOwner      Boolean     @default(false)
  approvedBy      String?
  approvedAt      DateTime?
  approveNote     String?
  ownerApprovedBy String?
  ownerApprovedAt DateTime?
  qboBillId       String?
  qboStatus       String?
  paidAt          DateTime?
  paidRef         String?
  disputeNote     String?
  disputedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([vendor, invoiceNumber])
  @@index([projectId])
}

// Collections call log on an overdue invoice: what was said, and when to follow up.
model CollectionNote {
  id         String    @id @default(cuid())
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  note       String
  // CALLED | LEFT_VM | EMAILED | PROMISED | DISPUTE
  outcome    String
  followUpOn DateTime?
  by         String
  createdAt  DateTime  @default(now())

  @@index([invoiceId])
}

// Owner audit: an owner's look at an approved item (supplier bill, crew invoice, voided invoice, change order).
model AuditReview {
  id        String   @id @default(cuid())
  // SUPPLIER_BILL | CREW_INVOICE | INVOICE_VOID | CHANGE_ORDER
  entity    String
  entityId  String
  // OK | FLAG
  result    String
  note      String?
  by        String
  byId      String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Something a crew found on the job (rotted decking, hidden damage), with photos, for the PM to price.
model FieldIssue {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  crewId         String?
  reportedBy     String
  note           String
  // [{ url, type }]
  photos         Json
  // OPEN | PRICED | NO_CHARGE
  status         String    @default("OPEN")
  // extra-work (T&M) tag: what the crew spent, and who on site authorized it
  kind           String? // ISSUE (found, needs pricing before work) | EXTRA (extra work done / directed on site)
  workDate       DateTime?
  men            Int?
  hours          Float? // total man-hours
  materials      String?
  directedBy     String? // super / builder rep who asked for it
  signerName     String?
  signatureImage String?
  signedAt       DateTime?
  changeOrderId  String?
  resolution     String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId, status])
}

// Estimating schedule (replaces the "BTR Estimating Schedule" Google Sheet). Rows from the sheet carry
// source = SHEET and are refreshed by each sync while the team still works in the sheet; rows added in
// BTRpro are source = APP and never touched by a sync.
model EstimateLog {
  id         String    @id @default(cuid())
  // SHEET | APP
  source     String    @default("APP")
  // stable key for a sheet row: tab + customer + project + first date (+ repeat count)
  sourceKey  String?   @unique
  sourceTab  String?
  sourceRow  Int?
  // CURRENT | MISC | PASSING | SENT | REDRAW | LOST | SOLD | ARCHIVE | TRACT
  board      String
  // COMMERCIAL | RESIDENTIAL
  market     String
  // NEW_BUILD | REMODEL (residential), or a builder group like "Hildy Homes"
  kind       String?
  // STANDARD | ASAP | SOLD_RFQ | REVIEW
  priority   String    @default("STANDARD")
  customer   String?
  project    String
  scope      String?
  estimator  String?
  receivedAt DateTime?
  dueAt      DateTime?
  sentAt     DateTime?
  bidDate    DateTime?
  status     String?
  waitingOn  String?
  sentTo     String?
  results    String?
  notes      String?
  folderLink String?
  // other columns kept as label → text (Hardie exp., reason, winning sub, PM, super, sell, profit…)
  extra      Json?
  projectId  String?
  job        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  updatedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([board, market])
  @@index([dueAt])
}

// Ideas from the team: what would make their work faster. Claude reads the open ones and builds them.
model Idea {
  id          String    @id @default(cuid())
  title       String
  details     String
  // how often the problem comes up: DAILY | WEEKLY | MONTHLY | RARELY
  often       String    @default("WEEKLY")
  // minutes it would save each time (their guess)
  minutes     Int?
  area        String?
  // NEW | PLANNED | BUILDING | DONE | NOT_NOW
  status      String    @default("NEW")
  reply       String?
  votes       Json      @default("[]")
  createdById String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  doneAt      DateTime?

  @@index([status])
}

// Production board: one work line (a building, a lot, a trade, a change order) from the Residential and
// Commercial live schedules, with payout and sell. Synced from the sheets until BTRpro is the schedule;
// a row edited here (source APP) is never overwritten by a sync.
model ProdLine {
  id           String    @id @default(cuid())
  source       String    @default("APP")
  sourceKey    String?   @unique
  sourceTab    String?
  sourceRow    Int?
  // RESIDENTIAL | COMMERCIAL
  market       String
  // UPCOMING | CURRENT | ADD (new, waiting to be placed) | WARRANTY | COMPLETED
  board        String
  // tab / super / builder group, and the section label inside it ("Hildy Upcoming", "DR Horton Warranty")
  grp          String?
  section      String?
  // commercial project this line belongs to ("Lund Ross - Thriving Communities")
  project      String?
  dateAdded    DateTime?
  estimateNo   String?
  vpo          String?
  builder      String?
  location     String?
  model        String?
  type         String?
  crew         String?
  superName    String?
  salesRep     String?
  notes        String?
  completed    String?
  completedAt  DateTime?
  payout       Float?
  paidToDate   Float?
  payoutWeek   Float?
  sell         Float?
  approved     String?
  billed       String?
  billedAt     DateTime?
  btrPaid      String?
  paidAt       DateTime?
  billingNotes String?
  // when the crew is on it (crew and PM schedules)
  startDate    DateTime?
  endDate      DateTime?
  crewId       String?
  projectId    String?
  job          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([market, board])
  @@index([builder])
}

// Commercial pay applications (AIA G702/G703). A contract holds the schedule of values; each monthly
// application snapshots the lines with work completed this period and stored materials.
model PayContract {
  id           String   @id @default(cuid())
  source       String   @default("APP")
  sourceKey    String?  @unique
  gc           String?
  project      String
  superName    String?
  // [{ item, description, scheduled, previous, thisPeriod, stored }]
  lines        Json
  retainagePct Float?
  submitVia    String?
  dueNote      String?
  pendingCOs   Float?
  projectId    String?
  job          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  apps         PayApp[]
}

model PayApp {
  id           String      @id @default(cuid())
  contractId   String
  contract     PayContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number       Int
  periodTo     DateTime
  // same shape as PayContract.lines, as billed on this application
  lines        Json
  retainagePct Float
  // DRAFT | SUBMITTED | PAID
  status       String      @default("DRAFT")
  submittedAt  DateTime?
  paidAt       DateTime?
  createdBy    String
  createdAt    DateTime    @default(now())

  @@unique([contractId, number])
}

// Data pulled in the background from connected supplier/report accounts (ABC Supply orders and invoices).
// Matched to a job by PO number / job name when one fits; the raw record is kept for reference.
model SupplierFeed {
  id         String    @id @default(cuid())
  // ABC_SUPPLY | EAGLEVIEW
  provider   String
  // ORDER | INVOICE | REPORT
  kind       String
  externalId String
  number     String?
  date       DateTime?
  poNumber   String?
  jobName    String?
  status     String?
  branch     String?
  total      Float?
  raw        Json?
  projectId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([provider, kind, externalId])
  @@index([projectId])
  @@index([date])
}

// One job folder in the company jobs Drive, found by the Drive job import (Settings → Move jobs from Drive).
// Drive is only read; files are copied into the BTRpro job's Documents.
model DriveJobFolder {
  id           String    @id @default(cuid())
  folderId     String    @unique
  name         String
  modifiedAt   DateTime?
  // PENDING | DONE | ERROR | SKIPPED
  status       String    @default("PENDING")
  fileCount    Int?
  totalBytes   Float?
  filesAdded   Int       @default(0)
  filesSkipped Int       @default(0)
  errors       Json?
  projectId    String?
  matchedBy    String?
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// Month-end WIP line kept for each open job, so fade and over/under billing can be compared month to month.
model WipSnapshot {
  id           String   @id @default(cuid())
  month        String
  projectId    String
  revenue      Float
  costToDate   Float
  estTotalCost Float
  pctComplete  Float
  earned       Float
  billed       Float
  overUnder    Float
  projectedGp  Float
  bidMarginPct Float?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@unique([month, projectId])
  @@index([projectId])
}

// One-off cash items for the 13-week forecast (a loan draw, an equipment payment, a big expected check).
model CashItem {
  id        String   @id @default(cuid())
  date      DateTime
  label     String
  // positive = money in, negative = money out
  amount    Float
  createdBy String?
  createdAt DateTime @default(now())
}

// BTRbot's read of a contract / subcontract on a job: risky clauses quoted word for word, key terms, and what's missing.
model ContractReview {
  id         String   @id @default(cuid())
  projectId  String
  documentId String
  summary    String
  terms      Json
  findings   Json
  missing    Json
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([documentId])
}

// Code & spec library: links the team adds (codes, manufacturer installation instructions, standards).
model LibraryLink {
  id           String   @id @default(cuid())
  // CODE | MANUFACTURER | STANDARD | LOCAL
  kind         String
  title        String
  url          String
  jurisdiction String?
  note         String?
  createdBy    String?
  createdAt    DateTime @default(now())
}

// A code / spec question answered by BTRbot with live web research, with the sources it cited.
model CodeQuestion {
  id           String   @id @default(cuid())
  question     String
  answer       String
  sources      Json
  jurisdiction String?
  projectId    String?
  officialOnly Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([projectId])
}

// ---------- Safety & prequalification ----------
// GCs prequalify subs on the OSHA 300A summary for the last 3 years, EMR (experience mod) on the carrier's
// letter, TRIR/DART rates, a safety program and a bonding letter. These hold the raw facts; the packet is built from them.
model SafetyIncident {
  id               String   @id @default(cuid())
  date             DateTime
  // OBSERVATION | NEAR_MISS | FIRST_AID | RECORDABLE | RESTRICTED | LOST_TIME | FATALITY
  kind             String
  personName       String?
  crewId           String?
  projectId        String?
  description      String
  daysAway         Int?
  daysRestricted   Int?
  correctiveAction String?
  createdBy        String
  createdAt        DateTime @default(now())

  @@index([date])
}

model ToolboxTalk {
  id        String   @id @default(cuid())
  date      DateTime
  topic     String
  presenter String
  crewId    String?
  projectId String?
  // one name per line
  attendees String
  notes     String?
  createdBy String
  createdAt DateTime @default(now())

  @@index([date])
}

// hours worked and average headcount per calendar year (the 300A denominators) and the EMR the carrier issued
model SafetyYear {
  year         Int      @id
  hoursWorked  Float?
  avgEmployees Float?
  emr          Float?
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}

// company-level files: COI, EMR letter, bonding letter, safety manual, W-9, licenses
model CompanyFile {
  id          String    @id @default(cuid())
  kind        String
  title       String
  fileUrl     String
  contentType String?
  expiresAt   DateTime?
  uploadedBy  String
  createdAt   DateTime  @default(now())
}

// Company playbook: how BTR does its repeat work, written down so it doesn't live in one person's head.
// Each procedure has an owner and a review cycle; overdue reviews show on the playbook page.
model Sop {
  id                String    @id @default(cuid())
  title             String
  area              String // OFFICE | ESTIMATING | PRODUCTION | PURCHASING | SAFETY | FINANCE
  ownerName         String?
  body              String // markdown steps
  reviewEveryMonths Int       @default(12)
  reviewedAt        DateTime?
  reviewedBy        String?
  draft             Boolean   @default(true)
  updatedBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ---------- Public bids ----------
// Bid boards BTRpro reads every morning: SDI's plan room, county/city IonWave and CivicEngage boards,
// any other page (read by BTRbot), and SAM.gov federal work. Each posting lands in PublicBid for triage.
model BidSource {
  id            String      @id @default(cuid())
  name          String
  // SDI | IONWAVE | CIVIC | PAGE | SAM
  kind          String
  url           String
  // used when a posting doesn't say where (a county board's own town)
  defaultCity   String?
  defaultState  String?
  enabled       Boolean     @default(true)
  builtIn       Boolean     @default(false)
  lastCheckedAt DateTime?
  lastOkAt      DateTime?
  lastError     String?
  lastCount     Int?
  contentHash   String?
  createdBy     String?
  createdAt     DateTime    @default(now())
  bids          PublicBid[]
}

model PublicBid {
  id            String    @id @default(cuid())
  sourceId      String
  source        BidSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  key           String    @unique
  title         String
  number        String?
  agency        String?
  city          String?
  state         String?
  dueAt         DateTime?
  postedAt      DateTime?
  url           String?
  summary       String?
  // straight-line miles to the nearer of Omaha / Lincoln (null = town not found)
  miles         Float?
  nearest       String?
  // ROOFING | EXTERIOR | BUILDING | OTHER
  relevance     String
  // NEW | WATCH | PASS | ADDED
  status        String    @default("NEW")
  decidedBy     String?
  decidedAt     DateTime?
  estimateLogId String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  // no longer listed on the source
  gone          Boolean   @default(false)

  @@index([status, dueAt])
}

// ---------- Customer request form (public link) ----------
// A homeowner or property manager fills in /quote: who they are, the property, what they want done, photos.
// It becomes a LEAD job right away; they can then try looks on their own photo (renderings); the sales
// manager assigns a salesperson, who sets up the inspection.
model WebLead {
  id               String    @id @default(cuid())
  token            String    @unique
  projectId        String?
  project          Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  phone            String
  email            String
  contactPref      String? // CALL | TEXT | EMAIL
  textOk           Boolean   @default(false)
  street           String
  city             String
  state            String
  zip              String
  // HOME | TOWNHOME | MULTIFAMILY | COMMERCIAL | CHURCH_SCHOOL | OTHER
  propertyType     String
  // OWNER | PROPERTY_MANAGER | TENANT | BUILDER | OTHER
  relationship     String
  workTypes        Json
  description      String
  stories          String?
  currentRoof      String?
  roofAge          String?
  insurance        Boolean   @default(false)
  insuranceCarrier String?
  claimNumber      String?
  dateOfLoss       DateTime?
  timeline         String?
  heardFrom        String?
  inspectionTimes  String?
  // [{ url, type }]
  photos           Json
  // [{ url, label, choices, favorite, at }]
  renderings       Json?
  renderCount      Int       @default(0)
  // NEW | ASSIGNED | SCHEDULED | CLOSED
  status           String    @default("NEW")
  assignedToId     String?
  assignedAt       DateTime?
  assignedBy       String?
  inspectionAt     DateTime?
  inspectionWhen   String?
  ip               String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
}

// Progress billing schedule: the draws a job is billed in (deposit → progress → final). Each draw comes due on a
// job event; when it does the office gets a task and one click drafts the invoice for it.
model BillingStep {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order       Int
  label       String
  // PERCENT (of the contract incl. approved change orders) | AMOUNT | REMAINDER (whatever is left to bill)
  basis       String
  pct         Float?
  amount      Float?
  // SIGNED | MATERIALS_DELIVERED | STARTED | COMPLETED | DATE | MANUAL
  trigger     String
  triggerDate DateTime?
  // PLANNED | READY | INVOICED | SKIPPED
  status      String    @default("PLANNED")
  readyAt     DateTime?
  invoiceId   String?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([status])
}

// A builder's plan book (e.g. DR Horton Kansas City master sheet): every model, its elevations and options, and
// per trade what to order, what it sells for and what the crew is paid. Each import is a new version; the
// newest active one is used. The data keeps the sheet's own numbers (sell, payout) next to the quantities.
model BuilderPlanBook {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label      String
  sourceUrl  String?
  sourceName String?
  data       Json
  active     Boolean  @default(true)
  importedBy String
  importedAt DateTime @default(now())

  @@index([companyId, active])
}

/// A builder's start paperwork (e.g. DR Horton "Selected Option Summary" PDF): which lot, model, elevation and
/// options are going. Read into `data`, matched to the builder's plan book, then put on the schedule.
model BuilderStart {
  id          String    @id @default(cuid())
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  fileUrl     String
  fileName    String
  data        Json
  readBy      String // PARSER | AI
  status      String    @default("NEW") // NEW | SCHEDULED | DISMISSED
  dedupeKey   String?
  prodLineIds Json?
  createdBy   String
  createdAt   DateTime  @default(now())
  scheduledAt DateTime?

  @@index([status, createdAt])
  @@index([dedupeKey])
}
