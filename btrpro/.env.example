# SQLite for local dev. For production use a Postgres URL and set provider = "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Signs login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# First admin account created by `npm run db:seed` (only if it doesn't exist yet).
SEED_ADMIN_EMAIL="admin@btrcontracting.local"
SEED_ADMIN_PASSWORD="change-me-now"

# AI (used from Phase 4 onward)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# File storage: "local" writes to ./uploads; "s3" uses the S3_* settings (Phase 5)
STORAGE_DRIVER="local"
S3_REGION="auto"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public URL of this app (OAuth redirects)
APP_URL="http://localhost:3000"

# Job email capture (Phase 4): forwarding address + mailbox pull
INBOUND_EMAIL_DOMAIN=""        # e.g. jobs.btrcontracting.com -> job-<token>@jobs.btrcontracting.com
INBOUND_EMAIL_WEBHOOK_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The app's own Drive access (recommended): a service account JSON key (raw or base64). Share folders with its email.
GOOGLE_SERVICE_ACCOUNT_JSON=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# Integrations (see Settings -> Integrations)
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
PROCORE_CLIENT_ID=""
PROCORE_CLIENT_SECRET=""
EAGLEVIEW_CLIENT_ID=""
EAGLEVIEW_CLIENT_SECRET=""
ABC_CLIENT_ID=""
ABC_CLIENT_SECRET=""
COMPANYCAM_TOKEN=""

# Outbound email (proposals, notices). Leave blank to copy links by hand.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="BTR Contracting <office@btrcontracting.com>"
# Public base URL used in customer proposal links
APP_URL=http://localhost:3000

# Online card payments on invoices (optional). Webhook: APP_URL/api/stripe/webhook, event checkout.session.completed
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Address suggestions on the job forms. Optional: without it, suggestions come from OpenStreetMap (Photon),
# which knows streets but often not house numbers/ZIPs. With a Google Maps Platform key (Places API (New) enabled)
# suggestions are exact. Server-side only; never exposed to the browser.
GOOGLE_MAPS_API_KEY=
